<?xml version="1.0"?>
<!--
  Minimal ClickHouse Server configuration for the embedded, self-contained
  deployment mode (see rel/self_contained_db.sh). Data/tmp/user-files paths
  are supplied as command-line overrides at container start so the same
  config works whether persistent storage is mounted or not; only the parts
  that never change (network, logging, users) live here.
-->
<clickhouse>
    <logger>
        <level>warning</level>
        <console>true</console>
    </logger>

    <http_port>8123</http_port>
    <tcp_port>9000</tcp_port>
    <listen_host>127.0.0.1</listen_host>

    <mark_cache_size>134217728</mark_cache_size>
    <uncompressed_cache_size>134217728</uncompressed_cache_size>
    <mlock_executable>false</mlock_executable>

    <default_profile>default</default_profile>
    <default_database>default</default_database>
    <users_config>users.xml</users_config>

    <max_concurrent_queries>100</max_concurrent_queries>
    <timezone>UTC</timezone>
</clickhouse>
